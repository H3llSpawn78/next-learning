{
	"name": "appius-nextjs-toolkit",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev-non-https": "next dev",
		"dev": "next dev --experimental-https",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --fix --ext .js,.jsx,.ts,.tsx src tests",
		"lint:only-changed": "eslint app tests --cache",
		"lint-staged": "lint-staged",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check-types": "next typegen && tsc --noEmit",
		"test": "playwright test",
		"test-playwright": "playwright test",
		"test-playwright-ui": "playwright test --ui",
		"test-playwright-report": "playwright show-report",
		"test-playwright-snapshot": "playwright test --update-snapshots --grep @snapshot",
		"profile": "turbo run profile",
		"prepare": "husky",
		"check-updates": "npx npm-check-updates --format group",
		"run-updates": "npx npm-check-updates -i --format group && pnpm install",
		"postbuild": "next-sitemap --config sitemap.config.js",
		"audit": "pnpm audit --prod --audit-level=critical"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.2.0",
		"@mui/material": "^9.2.0",
		"@mui/material-nextjs": "^9.1.1",
		"framer-motion": "^12.43.0",
		"ioredis": "^5.11.1",
		"next": "16.2.9",
		"next-auth": "5.0.0-beta.31",
		"next-sitemap": "^4.2.3",
		"react": "19.2.5",
		"react-dom": "19.2.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@next/eslint-plugin-next": "^16.2.4",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.59.1",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.2.4",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"msw": "^2.13.6",
		"playwright": "^1.59.1",
		"prettier": "3.8.3",
		"tailwindcss": "^4.2.2",
		"turbo": "^2.10.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@11.1.3",
	"lint-staged": {
		"*.{js,mjs,ts,tsx,mts}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"*.{json,css,md}": "prettier --write"
	}
}