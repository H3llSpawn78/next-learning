# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# With no variables set, the site runs entirely from the local seed content in
# lib/content/local-data.ts - so it works out of the box.
# =============================================================================

# Which content provider to use:
#   local -> reads from lib/content/local-data.ts (default)
#   rest  -> fetches JSON from any headless CMS / API (see lib/content/providers/rest.ts)
CMS_PROVIDER=local

# Base URL of your headless CMS REST API (only used when CMS_PROVIDER=rest).
# Expected endpoints (customise in providers/rest.ts):
#   GET {CMS_API_URL}/site
#   GET {CMS_API_URL}/projects
#   GET {CMS_API_URL}/projects/{slug}
#   GET {CMS_API_URL}/skills
#   GET {CMS_API_URL}/experience
CMS_API_URL=https://your-cms.example.com/api

# Optional bearer token sent as `Authorization: Bearer <token>`.
CMS_API_TOKEN=

# How long (seconds) fetched CMS content is cached before re-validating.
CMS_REVALIDATE_SECONDS=3600

# Hostname for CMS-hosted images, whitelisted in next.config.mjs for <Image>.
CMS_IMAGE_HOSTNAME=

# Shared secret for the on-demand revalidation webhook:
#   POST /api/revalidate   header: x-revalidate-secret: <secret>
# Point your CMS "publish" webhook here so changes go live instantly.
REVALIDATE_SECRET=
